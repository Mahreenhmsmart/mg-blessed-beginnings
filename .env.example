# ─── Server Environment Variables ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=your-secure-random-secret-here
CLIENT_URL=https://mgblessed.icod.ai
ADMIN_EMAIL=admin@mgblessed.icod.ai
ADMIN_PASSWORD=your-admin-password

# ─── Client (Vite) Environment Variables ──────────────────────────────────────
VITE_API_URL=https://api.mgblessed.icod.ai/api

# ─── AI Provider Configuration ───────────────────────────────────────────────
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.5-flash
AI_API_KEY=your-ai-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google Gemini API key (optional — used as fallback when no other provider is configured)
# The system checks GEMINI_API_KEY first, then GOOGLE_API_KEY, then AI_API_KEY
GEMINI_API_KEY=your_gemini_key_here
GOOGLE_API_KEY=your_gemini_key_here

# Groq API key (optional — free tier LLM provider)
GROQ_API_KEY=your-groq-key-here

# Luma AI (Dream Machine) — video and image generation (optional)
# Get your API key from https://lumalabs.ai/dream-machine/api
LUMA_API_KEY=your_luma_api_key_here
